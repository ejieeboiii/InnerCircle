# Copy to .env.local and fill privately. Never commit .env.local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Must belong to a PRIVATE Vercel Blob store. Used for direct uploads and migration.
BLOB_READ_WRITE_TOKEN=
# Hosted deployment:
NODE_ENV=production
# Leave bootstrap credentials unset when migrating your existing admin account.
# INNERCIRCLE_ADMIN_USERNAME=
# INNERCIRCLE_ADMIN_PASSWORD=
